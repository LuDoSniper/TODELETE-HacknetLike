{
  "name": "rift-os",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node server/rift/server.mjs\" \"vite --host 127.0.0.1\"",
    "setup": "prisma generate && prisma db push",
    "build": "vite build",
    "start": "node server/rift/server.mjs",
    "test": "node --test server/rift/*.test.mjs",
    "dev:watch": "concurrently -k \"node --watch-path=server/rift server/rift/server.mjs\" \"vite --host 127.0.0.1\""
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@xterm/xterm": "^5.5.0",
    "@xterm/addon-fit": "^0.10.0",
    "express": "^5.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "vis-network": "^9.1.9",
    "vis-data": "^7.1.9"
  },
  "devDependencies": {
    "vite": "^6.1.0",
    "typescript": "^5.7.0",
    "prisma": "^6.19.0",
    "concurrently": "^9.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
